graph LR
    Score[Score Total] --- WinCheck[Victoire Immédiate]
    Score --- MacroEval[Évaluation MacroBoard]
    Score --- MicroEval[Somme des Grilles Micro]
    Score --- FreeMove[Malus Free Move]
    
    subgraph Termination [Fin de Match]
        WinCheck --- Win[+1.000.000]
        WinCheck --- Loss[-1.000.000]
    end

    subgraph MacroBoard [Niveau Global]
        MacroEval --- MacroWeight[Coefficients : Centre 1.75, Coins 1.4]
        MacroEval --- MacroProgress[Alignements : Menace +/- 150, Progrès +/- 30]
    end
    
    subgraph MicroBoards [Niveau Local]
        MicroEval --- LocalWeights[Position : Centre 0.22, Coins 0.20]
        MicroEval --- LocalThreats[Menaces locales : +/- 45]
        MicroEval --- LocalDefense[Priorité défense : -90 si menacé]
    end
    
    style Win fill:#28a745,color:#fff
    style Loss fill:#dc3545,color:#fff
    style FreeMove fill:#ffc107,stroke:#856404
    style Score font-weight:bold,fill:#eee
