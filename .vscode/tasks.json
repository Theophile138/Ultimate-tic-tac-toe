{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-fno-lto",
                "${workspaceFolder}\\main.cpp", 
                "${workspaceFolder}\\TicTacToe.cpp",
                "${workspaceFolder}\\UltimateTicTacToe.cpp",
                "${workspaceFolder}\\Minimax.cpp",
                "-o",
                "${workspaceFolder}\\main.exe",
                
                // --- AJOUTS ICI ---
                "-I.",                               // Cherche les headers (.h) dans le dossier actuel 
                "-L.",                               // Cherche les librairies (.a) dans le dossier actuel 
                "-lUTTTLib",                         // Lien vers libUTTTLib.a 

                "-lallegro_font-5.2",                // Lien vers allegro_font 
                "-lallegro_ttf-5.2",                 // Lien vers allegro_ttf 
                "-lallegro_image-5.2",               // Lien vers allegro_image 
                "-lallegro_primitives-5.2",          // Lien vers allegro_primitives 
                "-lallegro-5.2"                      // Lien vers la base d'allegro 
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}